# true   — весь API обслуживается встроенным моком (бэкенд не нужен)
# false  — всё на BFF через vite-прокси /api -> http://localhost:8003
#          (лента/мэтчи/чаты пока не работают: их нет в BFF)
# hybrid — реализованное на бэке (аккаунт, анкета, уведомления) ходит на BFF,
#          лента/мэтчи/чаты остаются на сидированных моках
VITE_USE_MOCKS=true

# База для реальных запросов. Менять только если BFF живёт не за прокси.
VITE_API_BASE=/api
