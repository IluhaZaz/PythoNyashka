# true   — весь API обслуживается встроенным моком (бэкенд не нужен)
# false  — всё на BFF через vite-прокси /api -> http://localhost:8003
#          (мэтчи и чаты живые; лента свайпов отдаёт только id анкеты —
#           имён и фото нет, пока BFF не умеет GET /profiles/{id})
# hybrid — аккаунт, анкета, медиа, уведомления на BFF;
#          лента/мэтчи/чаты на сидированных моках (демо)
VITE_USE_MOCKS=true

# База для реальных запросов. Менять только если BFF живёт не за прокси.
VITE_API_BASE=/api
